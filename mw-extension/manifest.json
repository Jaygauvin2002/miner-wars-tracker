{
  "manifest_version": 3,
  "name": "Miner Wars — Espion",
  "version": "8.3",
  "description": "Capteur Miner Wars (GoMining) : capte les données du jeu et les envoie automatiquement vers ta page tracker pour analyse.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://app.gomining.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.gomining.com/*"],
      "js": ["bridge-game.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://jaygauvin2002.github.io/miner-wars-tracker/*"],
      "js": ["bridge-tracker.js"],
      "run_at": "document_idle"
    }
  ]
}
