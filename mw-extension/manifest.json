{
  "manifest_version": 3,
  "name": "Miner Wars — Spy",
  "version": "8.4",
  "description": "Miner Wars (GoMining) capturer: captures game data and auto-sends it to your tracker page for analysis.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://app.gomining.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.gomining.com/*"],
      "js": ["bridge-game.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://jaygauvin2002.github.io/miner-wars-tracker/*"],
      "js": ["bridge-tracker.js"],
      "run_at": "document_idle"
    }
  ]
}
